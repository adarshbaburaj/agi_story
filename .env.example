# Copy to .env (never commit it). Every key is optional: missing ones fall back to mocks.

# Gemini: vision casting, agents, Narrator, Cinematographer, 3D builder, poster
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash          # strong model (Narrator, casting, camera)
GEMINI_FAST_MODEL=gemini-2.5-flash     # fast model for per-agent beats
GEMINI_3D_MODEL=                       # the model that builds the 3D toys (e.g. the Gemini "Hydrogen" model id)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
POSTER_WITH_GEMINI=true

# Claude: backup brain when Gemini is unavailable (agents, casting vision, 3D builder)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ElevenLabs: one voice per object
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_NARRATOR_VOICE=pNInz6obpgDQGcFmaJgB
ELEVENLABS_VOICE_IDS=                  # optional "id:description,id:description"

# Sponsors: set <NAME>_API_URL (+ _API_KEY) to go live; adapters live in server/sponsors/
BRUIN_API_URL=
BRUIN_API_KEY=
BAND_API_URL=
BAND_API_KEY=
BAND_CHANNEL=after-hours
RUNWARE_API_KEY=
RUNWARE_IMAGE_MODEL=runware:100@1
ADAL_API_URL=
ADAL_API_KEY=
FINCH_API_URL=
FINCH_API_KEY=
TELEM_API_URL=
TELEM_API_KEY=
GLASSER_API_URL=
GLASSER_API_KEY=
CASURO_API_URL=
CASURO_API_KEY=
